---
<section id="cta" class="section cta">
  <div class="shell">
    <div class="cta__inner reveal">
      <span class="eyebrow">Start Here</span>
      <h2>Tell us about your technical challenge.</h2>
      <p class="lead">
        Share your data, your constraints, and what success looks like. We respond within 24 hours with an honest
        technical assessment.
      </p>
      <div class="cta__actions">
        <a href="/contact" class="button button--primary">Contact Us</a>
        <a href="/about" class="button">How We Work</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: clamp(5rem, 10vw, 8rem) 0;
  }

  .cta__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .cta__inner .lead {
    margin: 0 auto 1.5rem;
  }

  .cta__actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
